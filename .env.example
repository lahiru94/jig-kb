# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Turns on the conversational agent (Claude Agent SDK). Get a key from the Claude Console.
ANTHROPIC_API_KEY=

# Optional: the model the session agent uses (default claude-sonnet-5-5).
# JIG_AGENT_MODEL=claude-opus-5-5

# Optional: the port for the jig web app (default 4300).
# JIG_PORT=4300
